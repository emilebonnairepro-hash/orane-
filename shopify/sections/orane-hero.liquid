{%- comment -%}
  ORANE — bannière d'accueil
  Le nom en géant qui déborde, l'anneau rogné, la bouille qui suit le curseur
  et des stickers qu'on peut décoller (orane.js).
{%- endcomment -%}
<section class="o-hero" id="o-hero-{{ section.id }}">
  {%- render 'orane-ring', class: 'o-hero__ring' -%}
  {%- render 'orane-spark', color: 'lime', class: 'o-s1' -%}
  {%- render 'orane-spark', color: 'pink', class: 'o-s2' -%}
  {%- render 'orane-spark', color: 'blue', class: 'o-s3' -%}

  <div class="o-wrap o-hero__top">
    <p class="o-kicker">{{ section.settings.kicker_left }}</p>
    <p class="o-kicker">{{ section.settings.kicker_right }}</p>
  </div>

  <div class="o-wrap o-hero__stage">
    {%- if section.settings.lead != blank -%}
      <div class="o-hero__lead">{{ section.settings.lead }}</div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <p
        class="o-sticker o-drag o-bg-{{ block.settings.color }}{% if block.settings.round %} o-sticker--round{% endif %}"
        style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%; --r: {{ block.settings.rotate }}deg;"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
        {%- if block.settings.small != blank -%}<small>{{ block.settings.small }}</small>{%- endif -%}
      </p>
    {%- endfor -%}

    {%- render 'orane-bouille', class: 'o-hero__bouille' -%}

    {%- if section.settings.cta_label != blank -%}
      <a class="o-spin-cta o-hero__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
        <svg viewBox="0 0 150 150" aria-hidden="true">
          <defs><path id="o-circle-{{ section.id }}" d="M75 75 m-58 0 a58 58 0 1 1 116 0 a58 58 0 1 1 -116 0"/></defs>
          <text><textPath href="#o-circle-{{ section.id }}">{{ section.settings.cta_label }} ✦ {{ section.settings.cta_label }} ✦</textPath></text>
        </svg>
        <span aria-hidden="true">→</span>
        <span class="visually-hidden">{{ section.settings.cta_label }}</span>
      </a>
    {%- endif -%}

    {%- if section.settings.hint != blank -%}
      <p class="o-hero__hint">{{ section.settings.hint }}</p>
    {%- endif -%}
  </div>

  <div class="o-wrap">
    <p class="o-hero__word" aria-label="{{ shop.name }}">{{ section.settings.word }}</p>
  </div>
</section>

{% schema %}
{
  "name": "ORANE · Bannière",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker_left", "label": "Mention en haut à gauche", "default": "N°01 — soins pour bouilles qui rigolent" },
    { "type": "text", "id": "kicker_right", "label": "Mention en haut à droite", "default": "visage · corps · cheveux · homme" },
    { "type": "richtext", "id": "lead", "label": "Texte", "info": "Le gras est surligné en citron.", "default": "<p>Le secteur chuchote en nude. Nous, on parle fort, en couleurs, avec des <strong>formules toutes douces</strong> pour ta peau.</p>" },
    { "type": "text", "id": "cta_label", "label": "Bouton rond", "default": "voir les soins" },
    { "type": "url", "id": "cta_link", "label": "Lien du bouton" },
    { "type": "text", "id": "word", "label": "Grand mot", "default": "orane" },
    { "type": "text", "id": "hint", "label": "Petite astuce", "default": "psst : les stickers se décollent ✦" }
  ],
  "blocks": [
    {
      "type": "sticker",
      "name": "Sticker",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "zéro filtre" },
        { "type": "text", "id": "small", "label": "Petit texte" },
        { "type": "checkbox", "id": "round", "label": "Rond", "default": false },
        {
          "type": "select", "id": "color", "label": "Couleur", "default": "citron",
          "options": [
            { "value": "citron", "label": "Citron vert" },
            { "value": "rose", "label": "Rose bonbon" },
            { "value": "creme", "label": "Crème" },
            { "value": "mandarine", "label": "Mandarine" },
            { "value": "piscine", "label": "Bleu piscine" }
          ]
        },
        { "type": "range", "id": "x", "label": "Position horizontale", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 10 },
        { "type": "range", "id": "y", "label": "Position verticale", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "rotate", "label": "Inclinaison", "min": -20, "max": 20, "step": 1, "unit": "°", "default": -4 }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORANE · Bannière",
      "blocks": [
        { "type": "sticker", "settings": { "text": "peau neuve, mine de rien.", "color": "citron", "x": 2, "y": 62, "rotate": -5 } },
        { "type": "sticker", "settings": { "text": "zéro filtre", "small": "100 % pep's", "round": true, "color": "rose", "x": 62, "y": 6, "rotate": 10 } }
      ]
    }
  ]
}
{% endschema %}
