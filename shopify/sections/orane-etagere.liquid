{%- comment -%}
  ORANE — l'étagère : les produits d'une collection en cartes penchées,
  prix en sticker rond, ajout au panier sans quitter la page (orane.js).
{%- endcomment -%}
{%- assign collection = section.settings.collection | default: collections.all -%}
<section class="o-shelf" data-o-shelf>
  <div class="o-wrap">
    <div class="o-shelf__head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="o-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="o-title">{{ section.settings.title }}{% if section.settings.title_em != blank %}<br><em>{{ section.settings.title_em }}</em>{% endif %}</h2>
      </div>
      <div class="o-shelf__nav">
        <button type="button" class="o-round-btn" data-dir="-1" aria-label="Produits précédents">←</button>
        <button type="button" class="o-round-btn" data-dir="1" aria-label="Produits suivants">→</button>
        <a class="o-btn" href="{{ collection.url | default: routes.all_products_collection_url }}">{{ section.settings.all_label }}</a>
      </div>
    </div>

    <div class="o-shelf__track">
      {%- for product in collection.products limit: section.settings.limit -%}
        {%- assign kind = '' -%}
        {%- for tag in product.tags -%}
          {%- if tag contains '(Type)' -%}{%- assign kind = tag | remove: ' (Type)' -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        <article class="o-prod">
          <div class="o-prod__media">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.featured_image.alt | default: product.title, sizes: '(min-width: 750px) 30vw, 76vw' }}
            {%- else -%}
              <div class="o-flask">orane</div>
            {%- endif -%}
          </div>
          <p class="o-sticker o-sticker--round o-prod__price">{{ product.price | money }}</p>
          <div class="o-prod__body">
            {%- if kind != blank -%}<p class="o-prod__tag">{{ kind }}</p>{%- endif -%}
            <h3 class="o-prod__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="o-prod__pitch">{{ product.description | strip_html | truncatewords: 14, '…' }}</p>
            {%- if product.available -%}
              <form class="o-prod__form" action="{{ routes.cart_add_url }}" method="post">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="o-add">{{ section.settings.add_label }}</button>
              </form>
            {%- else -%}
              <div class="o-prod__form"><a class="o-add" href="{{ product.url }}" style="display:block;text-align:center;text-decoration:none">{{ section.settings.soldout_label }}</a></div>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ORANE · Étagère produits",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Mention", "default": "La boutique" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Tout ORANE," },
    { "type": "text", "id": "title_em", "label": "Titre en couleur", "default": "en vrac." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Nombre de produits", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "add_label", "label": "Bouton d'ajout", "default": "Dans mon panier" },
    { "type": "text", "id": "soldout_label", "label": "Bouton si épuisé", "default": "Voir le produit" },
    { "type": "text", "id": "all_label", "label": "Lien « tout voir »", "default": "Tout voir" }
  ],
  "presets": [{ "name": "ORANE · Étagère produits" }]
}
{% endschema %}
