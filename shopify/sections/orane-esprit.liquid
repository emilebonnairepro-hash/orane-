{%- comment -%} ORANE — l'esprit : cartes de couleur numérotées {%- endcomment -%}
<section id="esprit" class="orane-section orane-section--{{ section.settings.background }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}<p class="orane-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="orane-h2">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<div class="orane-intro">{{ section.settings.intro }}</div>{%- endif -%}
    <div class="orane-cards">
      {%- for block in section.blocks -%}
        <article class="orane-card orane-card--{{ block.settings.color }}" {{ block.shopify_attributes }}>
          <span class="orane-num">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          <div>{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ORANE · Cartes esprit",
  "tag": "div",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "L'esprit ORANE" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Le soin, version sourire" },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    {
      "type": "select", "id": "background", "label": "Fond", "default": "cream",
      "options": [
        { "value": "cream", "label": "Crème" },
        { "value": "aubergine", "label": "Aubergine" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Zéro timidité" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des aplats francs et des contours épais.</p>" },
        {
          "type": "select", "id": "color", "label": "Couleur", "default": "mandarine",
          "options": [
            { "value": "mandarine", "label": "Mandarine" },
            { "value": "rose", "label": "Rose bonbon" },
            { "value": "citron", "label": "Citron vert" },
            { "value": "piscine", "label": "Bleu piscine" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORANE · Cartes esprit",
      "blocks": [
        { "type": "card", "settings": { "color": "mandarine" } },
        { "type": "card", "settings": { "color": "rose", "title": "Rond partout" } },
        { "type": "card", "settings": { "color": "citron", "title": "Premier degré interdit" } }
      ]
    }
  ]
}
{% endschema %}
