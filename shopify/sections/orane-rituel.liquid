{%- comment -%} ORANE — le rituel : trois chiffres géants en escalier, chaque étape reliée à un produit {%- endcomment -%}
<section class="o-ritual">
  <div class="o-wrap">
    <div class="o-ritual__head">
      <div>
        {%- if section.settings.kicker != blank -%}<p class="o-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="o-title">{{ section.settings.title }}{% if section.settings.title_em != blank %}<br><em>{{ section.settings.title_em }}</em>{% endif %}</h2>
      </div>
      {%- if section.settings.sticker != blank -%}
        <p class="o-sticker o-sticker--round o-bg-piscine" style="--r: 8deg; --s: 14rem;">{{ section.settings.sticker }}</p>
      {%- endif -%}
    </div>
    <ol class="o-steps">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <li class="o-step" {{ block.shopify_attributes }}>
          <span class="o-step__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3>{{ block.settings.title }}</h3>
          {{ block.settings.text }}
          {%- if p != blank -%}
            <a class="o-chip" href="{{ p.url }}">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
              {%- else -%}
                <span class="o-chip__dot"></span>
              {%- endif -%}
              <span>{{ p.title }} · <strong>{{ p.price | money }}</strong></span>
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "ORANE · Rituel",
  "tag": "div",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Mention", "default": "Le rituel" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Trois gestes," },
    { "type": "text", "id": "title_em", "label": "Titre en couleur", "default": "mine de rien." },
    { "type": "text", "id": "sticker", "label": "Sticker", "default": "glow à la carte" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Tu nettoies" },
        { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Un geste doux, et c'est parti.</p>" },
        { "type": "product", "id": "product", "label": "Produit associé" }
      ]
    }
  ],
  "presets": [
    { "name": "ORANE · Rituel", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }] }
  ]
}
{% endschema %}
