{%- comment -%} ORANE — deux rubans de stickers qui se croisent et défilent en sens inverse {%- endcomment -%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span><i>✦</i>
  {%- endfor -%}
{%- endcapture -%}
<div class="o-tapes" aria-hidden="true">
  <div class="o-tape o-tape--b"><div class="o-tape__track">{{ items }}{{ items }}{{ items }}{{ items }}</div></div>
  <div class="o-tape o-tape--a"><div class="o-tape__track">{{ items }}{{ items }}{{ items }}{{ items }}</div></div>
</div>

{% schema %}
{
  "name": "ORANE · Rubans",
  "tag": "div",
  "class": "section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "phrase",
      "name": "Phrase",
      "settings": [{ "type": "text", "id": "text", "label": "Texte", "default": "zéro filtre" }]
    }
  ],
  "presets": [
    {
      "name": "ORANE · Rubans",
      "blocks": [
        { "type": "phrase", "settings": { "text": "fais pas ta timide" } },
        { "type": "phrase", "settings": { "text": "zéro filtre" } },
        { "type": "phrase", "settings": { "text": "glow à la carte" } },
        { "type": "phrase", "settings": { "text": "bouille de star" } },
        { "type": "phrase", "settings": { "text": "100 % pep's" } }
      ]
    }
  ]
}
{% endschema %}
