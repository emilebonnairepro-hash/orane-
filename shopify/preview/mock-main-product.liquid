{%- comment -%} Aperçu seulement : structure simplifiée de la section main-product de Dawn. {%- endcomment -%}
<section class="template-product">
<div class="page-width mock-pw">
  <style>.mock-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:5rem;align-items:start}.mock-pw{max-width:120rem;margin:0 auto;padding:4rem 5rem 8rem}@media(max-width:749px){.mock-grid{grid-template-columns:1fr;gap:3rem}.mock-pw{padding:2rem 1.6rem 6rem}}</style>
  <div class="product mock-grid">
    <div class="product__media-wrapper">
      <ul class="product__media-list" style="list-style:none;margin:0">
        <li class="product__media-item"><div class="product-media-container"><img src="{{ product.featured_image.src }}" style="display:block;width:100%" alt=""></div></li>
      </ul>
      <ul class="thumbnail-list" style="list-style:none;padding:0;display:flex;gap:1rem">
        <li><button class="thumbnail" aria-current="true" style="width:8rem;height:8rem;padding:0"><img src="{{ product.featured_image.src }}" style="width:100%" alt=""></button></li>
        <li><button class="thumbnail" style="width:8rem;height:8rem;padding:0"><img src="{{ product.featured_image.src }}" style="width:100%" alt=""></button></li>
      </ul>
    </div>
    <div class="product__info-wrapper">
      <div class="product__info-container" style="display:grid;gap:1.6rem">
        <div class="product__title"><h1 style="margin:0">{{ product.title }}</h1></div>
        <div class="price"><div class="price__regular"><span class="price-item price-item--regular">{{ product.price | money }}</span></div></div>
        {% render 'orane-buybox', product: product, threshold: 5000 %}
        <div class="product-form__input"><div class="quantity" style="display:inline-flex;padding:1rem 2rem;gap:3rem;font-weight:700"><span>−</span><span>1</span><span>+</span></div></div>
        <button class="product-form__submit button" style="padding:1.8rem;font:800 1.7rem var(--font-heading-family);background:#FF6A2B;color:#2A1240;width:100%">Ajouter au panier</button>
        <div class="product__accordion"><div class="accordion"><details><summary>Livraison</summary></details></div></div>
        <div class="product__accordion"><div class="accordion"><details><summary>Retours</summary></details></div></div>
      </div>
    </div>
  </div>
</div>
</section>
